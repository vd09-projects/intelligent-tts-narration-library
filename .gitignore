# Go
*.exe
*.test
*.out
/dist/
/bin/
vendor/

# Compiled binaries dropped at repo root by `make build` / `make build-mcp` / `make build-server`
/narrate
/narrate-mcp
/narrate-server

# Node / React (player/)
node_modules/
build/
.env
.env.*
!.env.example

# Editors
.vscode/
.idea/

# macOS
.DS_Store

# Audio + plan output (local-only sinks)
*.wav
/recordings/
/tmp/kokoro-*

# Python venv (kokoro subprocess runtime — per-machine)
.venv/

# Python bytecode cache (scripts/*.py, scripts/rvc-export/*.py)
__pycache__/
*.pyc

# TTS model weights (large, downloaded out-of-band per render/sherpa/README.md)
models/
assets

# RVC → ONNX export artifacts (#143). Large + regenerable via `make rvc-export`,
# backed up to the vd09-projects/rvc-voices HF repo. Belt-and-suspenders: `assets`
# above already ignores these wholesale, but keep the intent explicit in case that
# blanket rule is ever narrowed.
assets/rvc-models/**/onnx/*.onnx
assets/rvc-models/**/onnx/*.npy
assets/rvc-models/**/onnx/*.npz
assets/rvc-models/_shared/

# Claude handoff state — per-machine, regenerable; never commit
.claude/handoff/

.venv-rvc

# RVC parity fixtures — local/generated, hosted per #151, never committed
# (README.md + fixtures.sha256 in that dir stay tracked; only the generated
# binaries + interrupted-fetch staging are ignored)
tests/rvc_parity/fixtures/*.wav
tests/rvc_parity/fixtures/*.npy
tests/rvc_parity/fixtures/*.part

# ── GPT-SoVITS voice artifacts (#161) ────────────────────────────────────────
# Large + non-redistributable clone (weights, reference audio, ~950MB base models);
# NEVER commit them. But DO track the DR runbook README — a deliberate improvement
# over the RVC README (which is untracked). git cannot re-include a file whose PARENT
# DIR is excluded, and the wholesale `assets` rule above excludes it, so re-include the
# parent-dir chain, immediately re-ignore the contents, then re-include ONLY the one
# README (last, so it wins). Other assets/* subdirs (rvc-models, huginn-samples,
# voice-clips) are re-ignored by `assets/*`, so their untracked status is unchanged.
!assets/
assets/*
!assets/gptsovits-models/
assets/gptsovits-models/*
# belt-and-suspenders: weights/audio/base stay ignored even if the line above narrows
assets/gptsovits-models/**/*.ckpt
assets/gptsovits-models/**/*.pth
assets/gptsovits-models/**/*.wav
assets/gptsovits-models/_base/
# ...but DO track the DR runbook / restore doc:
!assets/gptsovits-models/README.md

# GSO torch worker venv (per-machine; torch isolated to this subprocess, never linked)
.venv-gso